<nav class="navbar navbar-expand-lg border-bottom sticky-top">
    <div class="container-fluid">
        <!-- Logo -->
        <a class="navbar-brand" href="/listings">
            <img 
                src="/images/WanderNext-logo.png"
                alt="WanderNext"
                class="brand-logo"
            >
        </a>
        <!-- Mobile menu button -->
        <button 
            class="navbar-toggler" 
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <!-- Navbar links -->
        <div class="collapse navbar-collapse" id="navbarNav">
            <div class="navbar-nav navbar-links">
                <a class="nav-link" href="/listings">
                    <i>Explore</i>
                </a>
            </div>
            <div class="navbar-nav ms-auto">
                <form class="d-flex" role="search">
                    <input class="form-control me-2 search-input" type="text" name="search" placeholder="Search Destinations"/>
                    <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
                </form>
            </div>
        </div>
        <div class="collapse navbar-collapse" id="navbarNav">
            <div class="navbar-nav navbar-links">
                <a class="nav-link" href="/listings/new">
                    <i>WanderNext Your Home</i>
                </a>
                <% if(!locals.currUser) { %>
                    <a class="nav-link" href="/signup"><i>Sign Up</i></a>
                    <a class="nav-link" href="/login"><i>Log In</i></a>
                <% } %>
                <% if(locals.currUser) { %>
                    <a class="nav-link" href="/logout"><i>Log Out</i></a>
                <% } %>
            </div>
        </div>
    </div>
</nav>